<rml>
<head>
	<title>Scrollable overflow</title>
	<link type="text/rcss" href="../style.rcss"/>
	<link rel="help" href="https://drafts.csswg.org/css-overflow/#scrollable" />
	<meta name="Description" content="The size of the scrollable region of an element." />
	<meta name="Box 1" content="The scrollable region should include both the container's padding and child's margin, and be symmetric left and right." />
	<meta name="Box 2" content="The scrollable region should extend to the innermost blue border, but not its margin." />
	<meta name="Box 3" content="The child's margin overflows onto the container's padding box, which should produce a vertical scrollbar." />
	<style>
		body {
			display: block;
			background: #ddd;
			color: #444;
		}
		.container {
			border: 3px green;
			padding: 10px 30px;
			width: 400px;
			overflow: auto;
			margin: 50px 0;
		}
		.inner {
			border: 3px orange;
			width: 600px;
			height: 100px;
			padding: 10px;
			margin: 20px;
		}
		.innermost {
			border: 3px rgb(35, 108, 177);
			width: 800px;
			height: 50px;
			margin: 20px;
		}
		.container_bottom_padding {
			border: 3px green;
			width: 100px;
			height: 80px;
			padding-bottom: 20px;
			overflow: hidden auto;
		}
		.inner_margin_on_padding {
			border: 3px orange;
			padding: 0;
			margin: 0;
			width: 50px;
			height: 70px;
			margin-bottom: 15px;
		}
	</style>
</head>

<body>
<div class="container">
  <div class="inner">
  </div>
</div>
<div class="container">
  <div class="inner">
    <div class="innermost">
    </div>
  </div>
</div>
<div class="container_bottom_padding">
  <div class="inner_margin_on_padding">
  </div>
</div>
</body>
</rml>
