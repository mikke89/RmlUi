@font-face {
	font-family: "monospace";
	src: "/assets/RobotoMono-Regular.ttf", "/assets/RobotoMono-Bold.ttf";
}
@font-face {
	font-family: "monospace";
	src: "/assets/RobotoMono-Italic.ttf", "/assets/RobotoMono-BoldItalic.ttf";
	font-style: italic;
}

body {
	font-family: LatoLatin;
	font-weight: normal;
	font-style: normal;
	font-size: 14dp;
	color: black;
	background: #ccc;
	inset: 0;
	overflow: auto;
	display: flex;
	flex-direction: row;
}
p { margin: 0.8em 0; }

scrollbarvertical
{
	width: 16dp;
}
scrollbarhorizontal
{
	height: 16dp;
}
scrollbarvertical slidertrack,
scrollbarhorizontal slidertrack
{
	background: #aaa;
	border-color: #888;
}
scrollbarvertical slidertrack
{
	border-left-width: 1dp;
}
scrollbarhorizontal slidertrack
{
	height: 15dp;
	border-top-width: 1dp;
}
scrollbarvertical sliderbar,
scrollbarhorizontal sliderbar
{
	background: #ddd;
	border-color: #888;
}
scrollbarvertical sliderbar
{
	border-width: 1dp 0;
	margin-left: 1dp;
}
scrollbarhorizontal sliderbar
{
	height: 15dp;
	border-width: 0 1dp;
	margin-top: 1dp;
}
scrollbarcorner
{
	background: #888;
}

handle {
	position: relative;
	background: #555a;
	width: 16dp;
	height: 16dp;
	bottom: 0;
	right: 0;
	cursor: resize;
}

input.radio, input.checkbox {
	width: 10dp;
	height: 10dp;
	border: 1dp #666;
	background: #fff;
	tab-index: auto;
}
input.radio {
	border-radius: 5dp;
}
input.radio:hover, input.checkbox:hover {
	background: #ff3;
}
input.radio:active, input.checkbox:active {
	background: #ccc;
}
input.radio:checked, input.checkbox:checked {
	background: #222;
}
input.text, textarea {
	background-color: #fff;
	color: #000;
	border: 2dp #999;
	padding: 5dp;
	tab-index: auto;
	cursor: text;
	box-sizing: border-box;
	text-align: left;
}
input.text:focus, textarea:focus {
	border-color: #666;
}
input.text:placeholder-shown, textarea:placeholder-shown {
	color: #999;
}


#sources {
	flex: 1;
	height: 100%;
	display: flex;
	flex-direction: column;
}
#sources textarea {
	flex: 1;
	font-size: 13dp;
	background: #222;
	color: #ddd;
	font-family: monospace;
	box-sizing: border-box;
}
#sources #sandbox_rml_source {
	flex: none;
	height: 50%;
}
#sources handle {
	flex: none;
	height: 20dp;
	width: 100%;
}
#sources label {
	height: 20dp;
	line-height: 20dp;
	padding: 3dp 10dp;
}
#sources label input {
	vertical-align: center;
	margin-right: 0.2em;
}

#sandbox_wrapper {
	flex: 2;
	width: 500px;
	height: 100%;
	background-color: #123;
	box-sizing: border-box;
	border: 1px #000;
	position: relative;
}
#sandbox_target  {
	height: 100%;
	color: #000;
	text-align: left;
}
#col_rml_source
{
	min-width: 15%;
	max-width: 85%;
}
#row_source
{
	height: 40%;
	min-height: 15%;
	max-height: 85%;
}
.slider
{
	display: block;
	height: 100%;
	background: #3332;
	cursor: move;
	box-sizing: border-box;
	border: 4dp transparent;
}
.slider:hover, .slider:active
{
	background: #dda;
}
#vertical_slider
{
	width: 12dp;
	margin-left: 3dp;
	padding-top: 5dp;
}
#horizontal_slider
{
	height: 12dp;
}

button {
	display: inline-block;
	background: #aaa;
	border: 1dp #333;
	padding: 0.35em 1.6em;
	tab-index: auto;
	color: #000;
}
button:hover {
	color: #333;
	background: #cca;
}
button:active {
	background: #eec;
}

#menu {
	font-size: 15dp;
	background: #333;
	color: #ccc;
	width: 400dp;
	height: 100%;
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	gap: 2dp;
}
#menu h1 {
	padding-bottom: 0.25em;
	margin-bottom: 1em;
	border-bottom: 1dp #555;
}
#menu section {
	display: block;
	background: #222;
	padding: 20dp;
	box-sizing: border-box;
}
#menu .row {
	display: flex;
	align-items: center;
	margin: 0.5em 0 0.2em;
}
#menu label {
	width: 150dp;
}
#menu .row.buttons {
	display: flex;
	justify-content: space-between;
	align-items: center;
}
#load_file_status {
	margin-right: 1em;
	font-size: 0.9em;
	color: #7c7;
	visibility: hidden;
	transition: visibility 5s;
}
#load_file_status.error {
	color: #e77;
}
#load_file_status.visible {
	visibility: visible;
}

section#log_section {
	display: flex;
	flex-direction: column;
	flex: 1;
}
#log_section h1 {
	margin-bottom: 0.5em;
}
#clear_log {
	float: right;
	margin-top: -0.3em;
	padding: 0.1em 0.8em;
	font-size: 0.8em;
}
#log {
	flex: 1;
	overflow-y: auto;
	font-family: monospace;
	font-size: 12dp;
	background: #1a1a1a;
	padding: 5dp;
	color: #bbb;
}
#log div {
	display: block;
	margin-bottom: 0.2em;
	word-break: break-word;
}
#log .error, #log .assert { color: #f88; }
#log .warning { color: #fd8; }
#log .info { color: #8cf; }
#log .debug { color: #888; }
